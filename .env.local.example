NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only key for admin user invitations and role management. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Strong random secret (32+ characters) for encrypting third-party credentials at rest.
INTEGRATIONS_ENCRYPTION_KEY=replace_with_a_random_secret_of_at_least_32_characters
